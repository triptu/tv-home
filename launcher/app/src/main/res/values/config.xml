<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then build and install again (see the README).
  Package names: `adb shell pm list packages`.
-->
<resources>

    <!-- Apps pinned to the dock at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.google.android.youtube.tvmusic</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the TV's own Live TV app). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- Tiles per row in the All apps grid. The dock shows the dock_apps above plus an All apps tile. -->
    <integer name="columns">6</integer>
</resources>
