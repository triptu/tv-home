<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then build and install again (see the README).
  Package names: `adb shell pm list packages`.
-->
<resources>

    <!-- The dock at the bottom, in this order, until it is changed on the TV: hold OK on any tile to add it to the
         dock, move it or take it out. Over adb, start home with the string extra dock_apps set to "a,b,c" (an empty
         string goes back to this list; see MainActivity.readSettings). Missing apps are skipped; at most 5 (Dock.MAX). -->
    <string-array name="dock_apps">
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.google.android.youtube.tvmusic</item>
    </string-array>

    <!-- Apps never shown as tiles (e.g. the TV's own Live TV app). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- Seconds each painting stays on the home screen and screensaver. To change it without rebuilding,
         start home with the int extra art_interval_seconds over adb (see MainActivity.readSettings). -->
    <integer name="art_interval_seconds">45</integer>

    <!-- Tiles per row in the All apps grid. The dock shows the dock_apps above plus an All apps tile. -->
    <integer name="columns">6</integer>
</resources>
