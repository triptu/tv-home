<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <!-- Cards and buttons draw their own focus; the system overlay showed as a grey box beside the lifted card. -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- Stronger than the default so floating cards separate from light paintings. -->
        <item name="android:ambientShadowAlpha">0.25</item>
        <item name="android:spotShadowAlpha">0.35</item>
    </style>

    <!-- Round glass icon button, tvOS style: faint at rest, solid white with a dark icon when focused. -->
    <style name="TopButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:background">@drawable/round_button_bg</item>
        <item name="android:tint">@drawable/button_icon_tint</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
</resources>
