<?xml version="1.0" encoding="utf-8"?>
<!--
  Art first: the painting fills the screen; a quiet clock top left, two round buttons top right, and the
  quote above a small dock at the bottom. The other apps live in a panel that slides up over the art.
  Spacing is on an 8dp grid: 48dp side margins, 32dp top and bottom.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.gathin.tvhome.WallpaperView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants" />

    <LinearLayout
        android:id="@+id/clockBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#F2FFFFFF"
            android:textSize="36sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 250"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowRadius="10" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="6dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.16"
            android:textAllCaps="true"
            android:shadowColor="#80000000"
            android:shadowRadius="8" />
    </LinearLayout>

    <!-- The 4dp padding leaves room for the focus scale; the margins make up for it. -->
    <LinearLayout
        android:id="@+id/topButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="44dp"
        android:layout_marginTop="28dp"
        android:padding="4dp"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnArt"
            style="@style/TopButton"
            android:layout_marginStart="0dp"
            android:contentDescription="@string/art_mode"
            android:src="@drawable/ic_art_mode" />


        <ImageView
            android:id="@+id/btnSettings"
            style="@style/TopButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- Quote and dock, centred at the bottom; the quote lines up with the dock strip's left edge. -->
    <LinearLayout
        android:id="@+id/bottomBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="32dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginBottom="24dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/quoteText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="520dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:breakStrategy="balanced"
                android:textColor="#E6FFFFFF"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.2"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 300"
                android:shadowColor="#CC000000"
                android:shadowRadius="12" />

            <TextView
                android:id="@+id/quoteAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 500"
                android:letterSpacing="0.2"
                android:textAllCaps="true"
                android:shadowColor="#CC000000"
                android:shadowRadius="10" />
        </LinearLayout>

        <!-- 4dp padding plus each tile's 8dp makes the strip's 12dp padding. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="4dp"
            android:background="@drawable/dock_bg"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>

    <!-- Every other app, over the dimmed art. Hidden until All apps or Down from the dock. -->
    <FrameLayout
        android:id="@+id/gridPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E00A0A0C"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/gridContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="32dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="8dp"
                android:text="@string/all_apps"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:letterSpacing="0.16"
                android:textAllCaps="true" />

            <!-- Six 120dp columns: 104dp cards with 16dp between them. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="728dp"
                android:layout_height="wrap_content"
                android:padding="4dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>
    </FrameLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
