<?xml version="1.0" encoding="utf-8"?>
<!--
  Art first: the painting fills the screen; the clock, date and quote straight on it top left, two round
  buttons top right, and a small dock at the bottom. The other apps live in a panel that slides up over
  the art. 48dp side margins.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.gathin.tvhome.WallpaperView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="noHideDescendants" />

    <!-- Clock and date, then the quote for the current picture, on one left edge at 48dp. -->
    <LinearLayout
        android:id="@+id/topLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#F2FFFFFF"
            android:textSize="36sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 250"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:shadowColor="#80000000"
            android:shadowRadius="8" />

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="6dp"
            android:format12Hour="@string/date_format"
            android:format24Hour="@string/date_format"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.16"
            android:textAllCaps="true"
            android:shadowColor="#80000000"
            android:shadowRadius="8" />

        <!-- Host for the idle fade; the quote inside fades with each new picture. -->
        <FrameLayout
            android:id="@+id/quoteHost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <include layout="@layout/quote_panel" />
        </FrameLayout>
    </LinearLayout>

    <!-- The 4dp padding leaves room for the focus scale; the margins make up for it. -->
    <LinearLayout
        android:id="@+id/topButtons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="44dp"
        android:layout_marginTop="28dp"
        android:padding="4dp"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnArt"
            style="@style/TopButton"
            android:layout_marginStart="0dp"
            android:contentDescription="@string/art_mode"
            android:src="@drawable/ic_art_mode" />


        <ImageView
            android:id="@+id/btnSettings"
            style="@style/TopButton"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- The dock, centred at the bottom. -->
    <LinearLayout
        android:id="@+id/bottomBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="22dp"
        android:orientation="vertical"
        android:clipChildren="false"
        android:clipToPadding="false">


        <!-- The cards float on the art; the padding leaves room for the focused card's lift and shadow. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="3dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:descendantFocusability="afterDescendants" />
    </LinearLayout>

    <!-- Every other app, over the dimmed art. Hidden until All apps or Down from the dock. -->
    <FrameLayout
        android:id="@+id/gridPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E00A0A0C"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/gridContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="22dp"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="8dp"
                android:text="@string/all_apps"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:letterSpacing="0.16"
                android:textAllCaps="true" />

            <!-- Six 102dp columns: 88dp cards with 14dp between them, like the dock. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="618dp"
                android:layout_height="wrap_content"
                android:padding="3dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
