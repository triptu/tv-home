<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver: the home screen's painting, quote and caption, with nothing else on screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <com.gathin.tvhome.WallpaperView
        android:id="@+id/wallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include
        layout="@layout/quote_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="34dp"
        android:layout_marginTop="32dp" />

    <!-- The picture's title and "Artist, year", bottom left like Apple TV's aerial location text. -->
    <LinearLayout
        android:id="@+id/caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="48dp"
        android:layout_marginBottom="32dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/captionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="520dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:shadowDy="1" />

        <TextView
            android:id="@+id/captionByline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 400"
            android:letterSpacing="0.08"
            android:shadowColor="#99000000"
            android:shadowRadius="3"
            android:shadowDy="1" />
    </LinearLayout>
</FrameLayout>
