<?xml version="1.0" encoding="utf-8"?>
<!-- The quote for the current picture, set straight on the art; shared by the home screen and the screensaver. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quote"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.gathin.tvhome.TightTextView
        android:id="@+id/quoteText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="340dp"
        android:maxLines="3"
        android:ellipsize="end"
        android:breakStrategy="balanced"
        android:hyphenationFrequency="none"
        android:textColor="#F7FFFFFF"
        android:textSize="22sp"
        android:fontFamily="@font/cormorant_italic"
        android:fontVariationSettings="'wght' 500"
        android:shadowColor="#66000000"
        android:shadowRadius="4" />

    <TextView
        android:id="@+id/quoteAuthor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:singleLine="true"
        android:textColor="#BFFFFFFF"
        android:textSize="11sp"
        android:fontFamily="@font/outfit"
        android:fontVariationSettings="'wght' 400"
        android:shadowColor="#66000000"
        android:shadowRadius="4" />
</LinearLayout>
